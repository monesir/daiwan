{
  "manifest_version": 3,
  "name": "الديوان - تصميم اقتباس",
  "version": "2.3.6",
  "description": "إضافة توفر وضع ليلي شامل لموقع الديوان وأزرار لتغيير نوع وحجم خط القصائد.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.aldiwan.net/*"],
      "js": ["theme-init.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.aldiwan.net/*"],
      "css": ["dark-mode.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "*://*.aldiwan.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["arabic-poetry.otf"],
      "matches": ["*://*.aldiwan.net/*"]
    }
  ],
  "permissions": [
    "storage"
  ]
}
